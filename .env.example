# 키 이름만 적는다. 실제 값은 .env.local에 넣고 커밋하지 않는다.
# 로그인이 없으므로 Firebase 웹 설정값 · 카카오 키는 쓰지 않는다. (Firebase는 Hosting 배포에만 씀)

# 백엔드 API 주소 (비우면 같은 출처). 배포된 백엔드: https://nonstop-be.onrender.com
VITE_API_BASE_URL=
# 'false'로 두면 실제 API, 그 외(빈 값 포함)는 MSW 목 서버
VITE_API_MOCK=
# 'true'면 시연 도구(/demo) 화면을 등록한다
VITE_DEMO_TOOLS=
